{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epoch",
  "version": "1.0.3",
  "identifier": "com.pablocostas.epoch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "epoch",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNzUyQkEwMEQ5NjIzOTEKUldTUkk1WU5vQ3QxOEk1Sk9KUjJBTHdiSzM3UDBaNUhvV2FpSCtiT05PQmQvWjVLVmZhS1JhSnUK",
      "endpoints": [
        "https://github.com/PC0staS/epoch/releases/latest/download/latest.json"
      ]
    }
  }
}
